 CPVT_FontMap::CPVT_FontMap(CPDF_Document* doc,
                            RetainPtr<CPDF_Dictionary> pResDict,
@@ -37,6 +41,25 @@ void CPVT_FontMap::SetupAnnotSysPDFFont() {
   RetainPtr<CPDF_Font> pPDFFont =
       CPDF_InteractiveForm::AddNativeInteractiveFormFont(document_,
                                                          &sys_font_alias_);
+
+  if (!pPDFFont) {
+    constexpr FX_Charset kFallbackCharset =
+        FX_Charset::kMSWin_EasternEuropean;
+
+    auto fallback_font = std::make_unique<CFX_Font>();
+    fallback_font->LoadSubstFace(
+        CFX_Font::GetDefaultFontNameByCharset(kFallbackCharset),
+        true, 0, 0, 0,
+        FX_GetCodePageFromCharset(kFallbackCharset), false);
+
+    pPDFFont = CPDF_DocPageData::FromDocument(document_)->AddFont(
+        std::move(fallback_font), kFallbackCharset);
+
+    if (pPDFFont) {
+      sys_font_alias_ = "FallbackEE";
+    }
+  }
+
   if (!pPDFFont) {
     return;
   }
